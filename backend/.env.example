# copy this file to .env and fill values

# database connection string (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskmanager?schema=public"

# JWT secret - replace in production
JWT_SECRET="mude_para_um_valor_seguro"

# server port
PORT=5000

# environment (development|production|test)
NODE_ENV=development

# bcrypt salt rounds (adjust for security/performance)
SALT_ROUNDS=10